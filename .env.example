# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN — VINFAST MINH NGÂN PHÚ THỌ 3S
# Sao chép file này thành .env và điền các giá trị thực tế của môi trường máy chủ / local.
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env LÊN GIT HOẶC TÀI LIỆU CHIA SẺ CÔNG KHAI!

# --- CƠ SỞ DỮ LIỆU ---
DB_NAME=vinfast_minhnganphutho
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PREFIX=wp_

# --- ĐỊA CHỈ TRANG WEB ---
WP_HOME=https://vinfastminhnganphutho-3s.com.vn
WP_SITEURL=https://vinfastminhnganphutho-3s.com.vn

# --- CẤU HÌNH GỬI MAIL (SMTP GMAIL HOẶC HOSTING) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ngodinhdat15@gmail.com
SMTP_PASS=
SMTP_SECURE=tls

# --- THÔNG BÁO TELEGRAM BOT (ĐẶT CỌC & FORM TƯ VẤN) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

