<?php
/**
 * File mẫu cấu hình WordPress chuẩn bảo mật cho VinFast Minh Ngân Phú Thọ 3S
 * Hướng dẫn: Đổi tên file thành wp-config.php hoặc copy nội dung sang wp-config.php và cập nhật thông số kết nối Database.
 */

// Đọc file .env nếu tồn tại
if (file_exists(__DIR__ . '/.env')) {
    $lines = file(__DIR__ . '/.env', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        if (strpos(trim($line), '#') === 0 || strpos($line, '=') === false) continue;
        list($name, $value) = explode('=', $line, 2);
        $name = trim($name);
        $value = trim($value, " \t\n\r\0\x0B\"'");
        if (!defined($name)) define($name, $value);
    }
}

// ** Thông số Cơ sở dữ liệu ** //
define('DB_NAME',     defined('DB_NAME')     ? DB_NAME     : 'vinfast_minhnganphutho');
define('DB_USER',     defined('DB_USER')     ? DB_USER     : 'root');
define('DB_PASSWORD', defined('DB_PASSWORD') ? DB_PASSWORD : '');
define('DB_HOST',     defined('DB_HOST')     ? DB_HOST     : 'localhost');
define('DB_CHARSET',  'utf8mb4');
define('DB_COLLATE',  '');

/**#@+
 * Khóa xác thực và muối bảo mật (Authentication Unique Keys and Salts)
 * Tạo mới tại: https://api.wordpress.org/secret-key/1.1/salt/
 */
define('AUTH_KEY',         'vinfast-minhngan-salt-key-random-auth-2026-auth');
define('SECURE_AUTH_KEY',  'vinfast-minhngan-salt-key-random-sec-2026-sec');
define('LOGGED_IN_KEY',    'vinfast-minhngan-salt-key-random-log-2026-log');
define('NONCE_KEY',        'vinfast-minhngan-salt-key-random-nonce-2026-nonce');
define('AUTH_SALT',        'vinfast-minhngan-salt-key-random-authsalt-2026-as');
define('SECURE_AUTH_SALT', 'vinfast-minhngan-salt-key-random-secsalt-2026-ss');
define('LOGGED_IN_SALT',   'vinfast-minhngan-salt-key-random-logsalt-2026-ls');
define('NONCE_SALT',       'vinfast-minhngan-salt-key-random-noncesalt-2026-ns');
/**#@-*/

// Tiền tố bảng cơ sở dữ liệu
$table_prefix = defined('DB_PREFIX') ? DB_PREFIX : 'wp_';

// Cấu hình URL website nếu được chỉ định
if (defined('WP_HOME'))    define('WP_HOME', WP_HOME);
if (defined('WP_SITEURL')) define('WP_SITEURL', WP_SITEURL);

// Chế độ gỡ lỗi (Tắt khi lên Production)
define('WP_DEBUG', false);
define('WP_DEBUG_LOG', false);
define('WP_DEBUG_DISPLAY', false);

// Giới hạn bộ nhớ PHP cho WordPress
define('WP_MEMORY_LIMIT', '256M');
define('WP_MAX_MEMORY_LIMIT', '512M');

// Tắt chỉnh sửa file theme/plugin trực tiếp từ trang Admin WP để tăng tính an toàn
define('DISALLOW_FILE_EDIT', true);

/* Đường dẫn tuyệt đối tới thư mục WordPress */
if (!defined('ABSPATH')) {
    define('ABSPATH', __DIR__ . '/');
}

/* Khởi động cài đặt WordPress */
require_once ABSPATH . 'wp-settings.php';

